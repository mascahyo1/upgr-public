# Salin ke .env lalu isi. JANGAN commit .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=upgr
MYSQL_PASSWORD=isi-password-kuat
MYSQL_DB=upgr
# Secret key widget Cloudflare Turnstile (dashboard Cloudflare > Turnstile)
TURNSTILE_SECRET_KEY=
# Sitekey publik widget Turnstile (tampil di HTML login)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# JANGAN PERNAH =1 di production. Hanya dev/lokal untuk endpoint /api/_test/*
ALLOW_TEST_API=0
