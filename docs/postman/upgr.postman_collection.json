    },
    {
      "name": "4. Log webhook (maks 200/kredensial, tertua dibuang)",
      "item": [
        {
          "name": "List (filter: hasil, http, q, dari, sampai)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api_web/credentials/{{credId}}/logs?hasil=gagal"
          }
        },
        {
          "name": "Uji kirim (catat manual)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api_web/credentials/{{credId}}/logs",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"webhook_id\": \"{{webhookId}}\",\n  \"event\": \"Uji kirim\",\n  \"hasil\": \"terkirim\",\n  \"http\": 200,\n  \"pesan\": \"OK\"\n}"
            }
          }
        }
      ]
    },
