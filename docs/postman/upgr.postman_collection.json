{
  "info": {
    "name": "UPGR API",
    "description": "Koleksi API UPGR (Nuxt fullstack, MySQL). Variabel baseUrl menunjuk server target; koleksi ini dipakai lokal/dev/prod. Alur umum: 0 Uji (reset+seed, dev/lokal saja) > 1 Auth (login tenant/provider, wajib captcha Turnstile; dev memakai captcha dummy) > 2 Kredensial + 3 Webhook + 4 Log > 5 Tenant (API keys, profil) > 6 Provider (tenants, konfigurasi). Password/secret asli TIDAK disimpan di koleksi ini.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3200"
    },
    {
      "key": "credId",
      "value": "c-seed-sandbox"
    },
    {
      "key": "webhookId",
      "value": ""
    },
    {
      "key": "apiKeyId",
      "value": ""
    },
    {
      "key": "tenantId",
      "value": "t-seed-contoh"
    },
    {
      "key": "konfigId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Uji (dev/lokal saja, butuh ALLOW_TEST_API=1)",
      "item": [
        {
          "name": "Reset + seed kredensial",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api_web/_test/reset",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Seed user uji",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api_web/_test/seed-user",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Ping uji-kirim",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api_web/_test/ping",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
    },
    {
      "name": "1. Auth (throttle 10x/menit per IP, 429 + Retry-After)",
      "item": [
        {
          "name": "Login tenant",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api_web/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"area\": \"tenant\",\n  \"email\": \"uji@example.com\",\n  \"password\": \"sandi-uji-123\",\n  \"captcha\": \"dummy\"\n}"
            }
          }
        },
        {
          "name": "Login provider",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api_web/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"area\": \"provider\",\n  \"email\": \"provider@contoh.id\",\n  \"password\": \"ganti-dengan-asli\",\n  \"captcha\": \"dummy\"\n}"
            }
          }
        },
        {
          "name": "Profil saya (butuh cookie sesi)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api_web/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api_web/auth/logout",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Kredensial payment gateway",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api_web/credentials"
          }
        },
        {
          "name": "Tambah",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api_web/credentials",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Midtrans Sandbox\",\n  \"provider\": \"midtrans\",\n  \"is_production\": false,\n  \"merchant_id\": \"M-001\",\n  \"key\": \"SB-Mid-client-001\",\n  \"secret\": \"SB-Mid-secret-001\",\n  \"webhook_verify_token\": \"tok-sb-001\",\n  \"deskripsi\": \"Akun sandbox pengembang\",\n  \"status\": \"aktif\"\n}"
            }
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api_web/credentials/{{credId}}"
          }
        },
        {
          "name": "Ubah",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api_web/credentials/{{credId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Midtrans Sandbox 2\",\n  \"provider\": \"midtrans\",\n  \"is_production\": false,\n  \"merchant_id\": \"M-001\",\n  \"key\": \"SB-Mid-client-001\",\n  \"secret\": \"SB-Mid-secret-001\",\n  \"webhook_verify_token\": \"tok-sb-001\",\n  \"deskripsi\": \"Diubah\",\n  \"status\": \"aktif\"\n}"
            }
          }
        },
        {
          "name": "Test kredensial ke gateway (midtrans/xendit, tanpa buat transaksi)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api_web/credentials/{{credId}}/test",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Hapus",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api_web/credentials/{{credId}}"
          }
        },
        {
          "name": "Bulk hapus",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api_web/credentials/bulk-delete",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\n    \"{{credId}}\"\n  ]\n}"
            }
          }
        },
        {
          "name": "Bulk impor",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api_web/credentials/bulk-import",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rows\": [\n    {\n      \"nama\": \"Xendit Test\",\n      \"provider\": \"xendit\",\n      \"is_production\": false,\n      \"merchant_id\": \"X-1\",\n      \"key\": \"xnd-key-1\",\n      \"secret\": \"xnd-secret-1\",\n      \"deskripsi\": \"Dari impor\",\n      \"status\": \"aktif\"\n    }\n  ]\n}"
            }
          }
        }
      ]
    },
    {
